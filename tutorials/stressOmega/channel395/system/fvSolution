FoamFile { format ascii; class dictionary; object fvSolution; }
solvers { p { solver GAMG; smoother GaussSeidel; tolerance 1e-9; relTol 0.01; }
  "(U|k|omega|R)" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-9; relTol 0.1; } }
SIMPLE { nNonOrthogonalCorrectors 0; consistent yes; pRefCell 0; pRefValue 0;
  residualControl { p 1e-7; U 1e-8; omega 1e-8; R 1e-8; k 1e-8; } }
relaxationFactors { equations { U 0.9; k 0.7; omega 0.7; R 0.7; } }
